# Copy this file to ".env" and fill it in. Never upload .env to your website host or share it.

# Required: your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model: claude-haiku-5-5 is fast and low cost; claude-sonnet-5-5 gives richer answers.
ASSISTANT_MODEL=claude-haiku-5-5

# Your website address(es), comma separated. Requests from other sites are refused.
ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com

# Where the server downloads your website's knowledge (refreshed every hour).
KNOWLEDGE_URL=https://www.yourdomain.com/assets/data/assistant-knowledge.json

# Optional limits
PORT=8787
RATE_LIMIT_PER_MIN=12
DAILY_MESSAGE_CAP=3000
