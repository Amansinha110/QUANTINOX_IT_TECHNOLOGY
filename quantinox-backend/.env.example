# Copy to ".env" and fill in. Never commit or upload .env to your website host.

NODE_ENV=production
PORT=4000
# Where this backend is reachable, and where the website is
PUBLIC_URL=https://api.yourdomain.com
SITE_URL=https://www.yourdomain.com
# Other website addresses allowed to call the API (comma separated), e.g. the version without www
ALLOWED_ORIGINS=https://yourdomain.com
# Share login cookies between www. and api.  (leave empty if both are on the same host)
COOKIE_DOMAIN=.yourdomain.com
# 64 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

DATABASE_FILE=./data/quantinox.db
# Optional: also serve the website from this server (single-server setup)
SERVE_SITE_DIR=
# API documentation at /docs (default: on in development, off in production)
DOCS_ENABLED=false

# ---------- Email
# smtp = real email; log = save emails as files in data/outbox (for testing)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Quantinox <no-reply@yourdomain.com>
# New-lead alerts go here
SALES_EMAIL=sales@yourdomain.com
# Shown in customer emails as "Questions? Write to ..."
SUPPORT_EMAIL=support@yourdomain.com

# ---------- Integrations (optional)
# Every new lead is also POSTed here: Slack / Teams incoming webhook, Zapier, Make, your CRM
LEAD_WEBHOOK_URL=
# json or slack
LEAD_WEBHOOK_FORMAT=json
# Refuse passwords found in known data breaches (Have I Been Pwned, privacy-preserving)
HIBP_CHECK=true

# ---------- Quanta AI (optional). One key turns on: AI answers in the website assistant, the AI Solution
# Advisor plans, AI lead briefs and the AI insights report in the admin dashboard.
# Without a key the assistant runs in free site-guide mode and the advisor makes rule-based plans.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
KNOWLEDGE_URL=https://www.yourdomain.com/assets/data/assistant-knowledge.json
ASSISTANT_RATE_PER_MIN=12
ASSISTANT_DAILY_CAP=3000

# ---------- First admin (created on first start if no admin exists; remove afterwards)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner
