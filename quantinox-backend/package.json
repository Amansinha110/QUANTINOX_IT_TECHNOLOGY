{
  "name": "quantinox-backend",
  "version": "1.1.0",
  "private": true,
  "description": "Backend for the Quantinox website: accounts, leads, emails, newsletter, Quanta AI assistant and admin dashboard.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "fastify": "5.12.7",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  }
}
